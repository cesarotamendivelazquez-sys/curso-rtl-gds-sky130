# =====================================================================
#  .gitignore · Curso RTL → GDSII (12 h)
#  Regla del curso: en git va el CÓDIGO y los SCRIPTS; nunca el PDK,
#  nada bajo NDA, ni resultados pesados que se regeneran con `make`.
#  (Para versionar a propósito un ejemplo concreto: git add -f <archivo>)
# =====================================================================

# ---- PDKs y librerías (nunca) ----
pdks/
sky130A/
sky130B/
gf180mcu*/
.ciel/
.volare/
*.lib
*.db

# ---- Logs genéricos ----
*.log
*.jou

# ---- Salidas de los labs (make clean las borra) ----
labs/*/build/

# ---- Simulación (Icarus / Verilator / GTKWave) ----
sim_*
*.vvp
*.vcd
*.fst
*.ghw
obj_dir/
*.gtkw.bak

# ---- cocotb ----
sim_build/
results.xml
__pycache__/
*.pyc
.pytest_cache/

# ---- Verificación formal (SymbiYosys) ----
**/lab03-verif/**/prueba/
**/lab03-verif/**/bug/
*_bmc/
*_prove/

# ---- Síntesis (Yosys) ----
netlist.v
*.blif
*.json.gz
syn_out/

# ---- Place & Route (OpenROAD) ----
*.odb
*.def
*.spef
route_drc.rpt
results/
reports/

# ---- LibreLane / OpenLane ----
runs/

